# Required — api/config/config.go fails to start if any of these are unset.
# Config is read via os.Getenv; there is no .env auto-loading — export these
# in your shell before running `go run .`.

PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/immortalvibes
PROXY_SECRET=generate-a-long-random-string
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
ADMIN_SECRET=generate-a-long-random-string
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_KV_CARTS_ID=your-cloudflare-kv-namespace-id
CF_API_TOKEN=your-cloudflare-api-token
RESEND_API_KEY=re_...

# Optional — shipping automation (Shippo). Leave unset to disable.
SHIPPO_API_KEY=
FROM_NAME=
FROM_STREET1=
FROM_CITY=
FROM_STATE=
FROM_ZIP=
FROM_COUNTRY=US
FROM_PHONE=

# Optional — order alerts.
OWNER_EMAIL=
NTFY_URL=
NTFY_TOPIC=
